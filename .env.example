# Environment Configuration Template
# Copy this file to .env.dev, .env.staging, or .env.prod and fill in actual values
# DO NOT commit the actual .env.* files to version control

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=contoso-iwpb-uw
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
API_VERSION=v1

# Azure Settings
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id

# =============================================================================
# Azure Cosmos DB Configuration
# =============================================================================
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-key
COSMOS_DATABASE_NAME=underwriting
# Legacy aliases for backward compatibility
AZURE_COSMOS_ENDPOINT=${COSMOS_ENDPOINT}
AZURE_COSMOS_KEY=${COSMOS_KEY}
AZURE_COSMOS_DATABASE=${COSMOS_DATABASE_NAME}
AZURE_COSMOS_CONTAINER=documents

# =============================================================================
# Azure Blob Storage Configuration
# =============================================================================
BLOB_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net
BLOB_CONTAINER_NAME=documents
BLOB_CONNECTION_STRING=your-connection-string
# Legacy aliases for backward compatibility
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
AZURE_STORAGE_CONTAINER_NAME=${BLOB_CONTAINER_NAME}
AZURE_STORAGE_CONNECTION_STRING=${BLOB_CONNECTION_STRING}

# =============================================================================
# Azure Service Bus Configuration
# =============================================================================
SERVICE_BUS_NAMESPACE=your-namespace.servicebus.windows.net
SERVICE_BUS_QUEUE_NAME=document-processing
SERVICE_BUS_CONNECTION_STRING=your-connection-string

# =============================================================================
# Azure AI Services
# =============================================================================
AZURE_OPENAI_ENDPOINT=https://your-openai-endpoint.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Component Configuration
DOCUMENT_CLASSIFICATION_MODEL=azure-openai
ENTITY_EXTRACTION_MODEL=azure-openai
DOCUMENT_SUMMARIZATION_MODEL=azure-openai

# =============================================================================
# API Configuration
# =============================================================================
# Maximum upload file size in megabytes
MAX_UPLOAD_SIZE_MB=50

# Maximum documents per case
MAX_DOCUMENTS_PER_CASE=50

# SAS token expiration in hours
SAS_TOKEN_EXPIRY_HOURS=1

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Disable authentication for local testing (NEVER set to true in production)
DISABLE_AUTH=false

# =============================================================================
# Performance Settings
# =============================================================================
MAX_WORKERS=4
BATCH_SIZE=10
TIMEOUT_SECONDS=30

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_HUMAN_IN_LOOP=true
ENABLE_AUDIT_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true

# =============================================================================
# Application Insights (Optional)
# =============================================================================
# APPLICATIONINSIGHTS_CONNECTION_STRING=your-connection-string
