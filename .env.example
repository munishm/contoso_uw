# Environment Configuration Template
# Copy this file to .env.dev, .env.staging, or .env.prod and fill in actual values
# DO NOT commit the actual .env.* files to version control

# Application Settings
APP_NAME=hsbc-iwpb-uw
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Azure Settings
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_TENANT_ID=your-tenant-id

# Azure AI Services
AZURE_OPENAI_ENDPOINT=https://your-openai-endpoint.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure Storage
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
AZURE_STORAGE_CONTAINER_NAME=documents
AZURE_STORAGE_CONNECTION_STRING=your-connection-string

# Azure Cosmos DB
AZURE_COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
AZURE_COSMOS_KEY=your-cosmos-key
AZURE_COSMOS_DATABASE=underwriting
AZURE_COSMOS_CONTAINER=documents

# Component Configuration
DOCUMENT_CLASSIFICATION_MODEL=azure-openai
ENTITY_EXTRACTION_MODEL=azure-openai
DOCUMENT_SUMMARIZATION_MODEL=azure-openai

# Performance Settings
MAX_WORKERS=4
BATCH_SIZE=10
TIMEOUT_SECONDS=30

# Feature Flags
ENABLE_HUMAN_IN_LOOP=true
ENABLE_AUDIT_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true
