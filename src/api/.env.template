# =============================================================================
# HSBC Underwriting Case Management API - Environment Configuration
# =============================================================================
# Copy this file to .env in the project root and fill in actual values
# DO NOT commit .env files to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=hsbc-iwpb-uw
APP_ENV=development                    # development | staging | production
DEBUG=true                             # Enable debug mode (disable in production)
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR | CRITICAL
API_VERSION=v1                         # API version prefix

# -----------------------------------------------------------------------------
# Azure AD Authentication
# -----------------------------------------------------------------------------
# Get these from Azure Portal > Azure Active Directory > App registrations
AZURE_TENANT_ID=                       # Your Azure AD tenant ID
AZURE_CLIENT_ID=                       # Your application (client) ID
DISABLE_AUTH=true                      # Set to true for local development without Azure AD

# -----------------------------------------------------------------------------
# Azure Cosmos DB
# -----------------------------------------------------------------------------
# Get these from Azure Portal > Cosmos DB > Keys
COSMOS_ENDPOINT=                       # https://your-account.documents.azure.com:443/
COSMOS_KEY=                            # Primary or secondary key
COSMOS_DATABASE_NAME=underwriting      # Database name

# For local development with Cosmos DB Emulator:
# COSMOS_ENDPOINT=https://localhost:8081
# COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==

# -----------------------------------------------------------------------------
# Azure Blob Storage
# -----------------------------------------------------------------------------
# Get these from Azure Portal > Storage account > Access keys
BLOB_ACCOUNT_URL=                      # https://your-account.blob.core.windows.net
BLOB_CONTAINER_NAME=documents          # Container name for document storage
BLOB_CONNECTION_STRING=                # Connection string (alternative to account URL)

# For local development with Azurite:
# BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1

# -----------------------------------------------------------------------------
# Azure Service Bus
# -----------------------------------------------------------------------------
# Get these from Azure Portal > Service Bus > Shared access policies
SERVICE_BUS_NAMESPACE=                 # your-namespace.servicebus.windows.net
SERVICE_BUS_QUEUE_NAME=document-processing
SERVICE_BUS_CONNECTION_STRING=         # Connection string with Send/Listen permissions

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50                  # Maximum file upload size in MB
MAX_DOCUMENTS_PER_CASE=50              # Maximum documents allowed per case
SAS_TOKEN_EXPIRY_HOURS=1               # Pre-signed URL expiration time

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# -----------------------------------------------------------------------------
# Application Insights (Optional)
# -----------------------------------------------------------------------------
# Get from Azure Portal > Application Insights > Connection string
# APPLICATIONINSIGHTS_CONNECTION_STRING=
